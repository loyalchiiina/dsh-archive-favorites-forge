{
  "name": "dsh-archive-favorites-forge",
  "version": "0.24.4",
  "description": "Favourite any DSH conversation, copy its session id + transcript absolute path, delete one conversation permanently (guarded), batch-archive conversations idle for more than N hours, filter the sidebar down to favourites, and export a conversation list as tab-separated txt — additive slot extensions over the shipped archive feature, editing no official file. 为 DSH 对话加上收藏、复制 ID+路径、单条永久删除、超时批量归档与收藏筛选，并导出对话清单；全部挂在官方插槽上，不改官方一行代码。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/*.png",
    "locale/*.json",
    "icon.svg",
    "README-es.md",
    "README-pt.md",
    "README-hi.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "archive",
    "favorites",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-archive-favorites-forge.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-archive-favorites-forge#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
